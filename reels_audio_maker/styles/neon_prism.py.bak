"""Neon Prism — extruded 3D spectrum bars + mirrored waveform."""

from __future__ import annotations

import cv2
import numpy as np

from .base import (
    FrameContext,
    Palette,
    add_vignette,
    draw_hud,
    draw_waveform_strip,
    lerp_color,
    perspective_bar_poly,
    resample_spectrum,
    vertical_gradient,
)

PALETTES: list[Palette] = [
    Palette(
        "cyber_magenta",
        "Cyber Magenta",
        bg_top=(40, 0, 40),
        bg_bottom=(10, 0, 20),
        primary=(255, 0, 220),
